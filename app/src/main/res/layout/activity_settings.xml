<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="48dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/settings_message"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_api_id" />

        <EditText
            android:id="@+id/api_id"
            style="@style/FieldInput"
            android:hint="@string/settings_api_id_hint"
            android:inputType="number" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_api_hash" />

        <EditText
            android:id="@+id/api_hash"
            style="@style/FieldInput"
            android:hint="@string/settings_api_hash_hint"
            android:inputType="textNoSuggestions" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/settings_bot" />

        <EditText
            android:id="@+id/bot_username"
            style="@style/FieldInput"
            android:hint="@string/settings_bot_hint"
            android:inputType="textNoSuggestions|textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:autoLink="web"
            android:lineSpacingExtra="2dp"
            android:textColorLink="@color/link"
            android:text="@string/settings_help"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/show_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:checked="true"
            android:text="@string/settings_show_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/secure_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_secure_chat"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/settings_secure_chat_help"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/title_label"
            style="@style/FieldLabel"
            android:text="@string/settings_title_text" />

        <EditText
            android:id="@+id/title_text"
            style="@style/FieldInput"
            android:inputType="textCapCharacters" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/error"
            android:textSize="14sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/primary"
            android:text="@string/settings_save"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:text="@string/settings_cancel"
            android:textColor="@color/link"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
